{
  "mcpServers": {
    "argus": {
      "command": "uv",
      "args": [
        "run",
        "--active",
        "--project", "${CLAUDE_PLUGIN_ROOT}",
        "--locked",
        "--python", "3.12",
        "argus-mcp",
        "--tool-profile", "web"
      ],
      "env": {
        "VIRTUAL_ENV": "${CLAUDE_PLUGIN_DATA}/venv"
      }
    }
  }
}
