{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "argus": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--project", ".",
        "--locked",
        "--python", "3.12",
        "argus-mcp",
        "--tool-profile", "web"
      ],
      "cwd": "${PLUGIN_ROOT}"
    }
  }
}
